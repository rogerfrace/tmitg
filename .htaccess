AddType video/ogg .ogv
AddType audio/ogg .ogg
AddType video/mp4 .mp4
AddType video/mp4 .m4v
AddType video/webm .webm
AddType font/woff .woff
AddType font/woff2 .woff2

<IfModule mod_deflate.c>
		AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css \
			application/xml application/xhtml+xml application/rss+xml \
			application/javascript application/x-javascript \
			text/x-component text/richtext image/svg+xml text/xsd text/xsl image/x-icon
</IfModule>

<IfModule mod_headers.c>
	<Files ~ "\.(gif|jpg|png|ico|woff|ttf|eot|svg)$">
	    FileETag None
		Header set Cache-Control "max-age=604800, public"
		Header set ExpiresDefault "access plus 7 days"
	</Files>
	<Files ~ "\.(js|css)$">
	    FileETag None
		Header set Cache-Control "max-age=28800, public"
		Header set ExpiresDefault "access plus 8 hours"
	</Files>
	<Files ~ "\.woff$">
		Header set Vary "Accept-Encoding"
	</Files>
	<Files ~ "\.css\.php$">
	    FileETag None
	</Files>

	<Files "index.php">
 	   Header set Link "</index.md>; rel=\"alternate\"; type=\"text/markdown\""
	</Files>
	
	<Files "index.md">
		Header set Link "</>; rel=\"alternate\"; type=\"text/html\""
		Header set Content-Type "text/markdown; charset=UTF-8"
	</Files>
</IfModule>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine on

  # my rules
	RewriteRule ^news-rss\.xml$ news-rss.xml.php [L]
	RewriteRule ^index\.md$ index.md.php [L]

  # 2020 promo code downloads
  # RewriteRule ^code/abcdefgh$ https://www.tmitg.com/files/tmitg-promo.php?receipt=Name [R=301,L]
       
  # dead things
  RewriteRule ^fanarea(.*)$ - [G,NC]
  RewriteRule ^media(.*)$ - [G,NC]
  RewriteRule ^mobile/$ - [G,NC]
  RewriteRule ^m/$ - [G,NC]
  RewriteRule ^xv/$ - [G,NC]
  RewriteRule ^mp3-(.*)$ - [G,NC]
  RewriteRule ^viewmp3\.php(.*)$ - [G,NC]
  RewriteRule ^(.*)\.mp3111$ - [G,NC]
  RewriteRule ^(.*)showstop=1$ - [G,NC]
</IfModule>
